<meta charset="utf-8">
<title>{{ exam_title }} {{ exam_round }}</title>
<style>
@page { size: A4; margin: 17mm 15mm 18mm 15mm; }
* { box-sizing: border-box; }
body {
  font-family: 'Malgun Gothic', 'Noto Sans KR', sans-serif;
  font-size: 9.8pt; line-height: 1.55; color: #000; margin: 0;
  -webkit-print-color-adjust: exact; print-color-adjust: exact;
}
p { margin: 0 0 3.2pt; }

/* ── 표지 ───────────────────────────────── */
.cover { height: 246mm; display: flex; flex-direction: column;
         align-items: center; justify-content: center; text-align: center;
         break-after: page; }
.cover .brand { font-size: 12pt; letter-spacing: 6pt; color: #444; margin-bottom: 6mm; }
.cover .rule { width: 62mm; border-top: 1.6pt solid #111; margin: 0 0 9mm; }
.cover h1 { font-size: 31pt; font-weight: 800; letter-spacing: 2pt; margin: 0 0 5mm; }
.cover h2 { font-size: 15pt; font-weight: 600; color: #333; margin: 0 0 14mm; letter-spacing: 3pt; }
.cover .meta { font-size: 11pt; color: #222; line-height: 2; margin-bottom: 16mm; }
.cover .idbox { border: 1pt solid #111; padding: 6mm 12mm; }
.cover .idbox table { border-collapse: collapse; }
.cover .idbox td { padding: 3mm 5mm; font-size: 10.5pt; }
.cover .idbox td.lab { font-weight: 700; border-right: 0.6pt solid #999; }
.cover .idbox td.blank { width: 46mm; border-bottom: 0.6pt solid #666; }

/* ── 안내면 ─────────────────────────────── */
.info { break-after: page; }
.info h3 { font-size: 14pt; text-align: center; margin: 0 0 3mm; letter-spacing: 2pt; }
.info .sub { text-align: center; color: #555; font-size: 9.5pt; margin-bottom: 8mm; }
.info table.plan { width: 100%; border-collapse: collapse; margin-bottom: 8mm; font-size: 9.5pt; }
.info table.plan th, .info table.plan td { border: 0.6pt solid #333; padding: 2mm 2mm; text-align: center; }
.info table.plan th { background: #eee; font-weight: 700; }
.info ol { margin: 0; padding-left: 6mm; }
.info li { margin-bottom: 2.2mm; }
.notice { border: 1pt solid #111; padding: 5mm 6mm; }
.notice .t { font-weight: 700; margin-bottom: 3mm; font-size: 10.5pt; }

/* ── 문항 ──────────────────────────────── */
/* 문제집에는 영역 헤더를 두지 않는다. 지면을 잡아먹고, 영역 구성은
   응시 안내 페이지의 구성표(영역별 문항 수·번호 범위)로 충분하다.
   해설집(solution.html.j2)에는 채점 편의를 위해 남겨 둔다. */
/* .qset 자체에는 break-inside:avoid 를 걸지 않는다. 펼침 배치에서
   지문(.qhead) 뒤에 의도적으로 면을 넘겨야 하기 때문이다.
   대신 지문 묶음과 개별 문항을 각각 통째로 유지한다. */
.qset { margin-bottom: 2mm; }
/* 지문 묶음 아래를 띄운다. `.passage` 의 아래 여백(2.5mm)만으로는
   지문 바로 밑에 첫 문항이 달라붙는다 — 문항 사이가 8.5mm 인 것과 견주면 너무 좁다. */
.qhead { break-inside: avoid; break-after: avoid; margin-bottom: 6mm; }
/* 세트 안 문항끼리는 한 번 더 띄운다. 인접 형제의 마진은 상쇄되므로
   margin-top 이 아니라 **padding-top** 을 써야 실제로 벌어진다. */
.qbody .question + .question { padding-top: 3.5mm; }
.lead { font-weight: 700; margin: 4mm 0 2.2mm; break-after: avoid; }
.question { margin-bottom: 8.5mm; break-inside: avoid; }
.stem { margin-bottom: 3mm; padding-left: 6.6mm; text-indent: -6.6mm; break-after: avoid; }
.qno { font-weight: 800; margin-right: 1.6mm; }
.choices { list-style: none; margin: 1.6mm 0 0; padding: 0; break-inside: avoid; break-before: avoid; }
/* 2단 선지는 **가로로 먼저** 읽힌다 — ①② / ③④ / ⑤.
   `column-count` 는 세로로 먼저 채워 ①②③ / ④⑤ 가 되므로 쓰지 않는다.
   그리드는 행 우선이 기본이라 별도 지정 없이 원하는 순서가 나온다. */
.choices.c2 { display: grid; grid-template-columns: 1fr 1fr;
              column-gap: 7mm; align-items: start; }
.choices li { padding-left: 5.2mm; text-indent: -5.2mm; margin-bottom: 1mm;
              break-inside: avoid; }
.choices .m { font-weight: 600; }

/* ── 지문·자료 ─────────────────────────── */
/* 단독 문항의 자료(지문·표·상자·그림)와 선지 사이도 띄운다.
   세트는 `.qhead` 가 맡지만 단독 문항은 이 여백이 전부라 2.5mm 로는 붙어 보인다. */
.material { margin: 0 0 5mm; }
.passage { margin: 0 0 2.5mm; }
.passage { font-family: 'Batang', 'Noto Serif KR', serif; font-size: 9.6pt;
           line-height: 1.72; text-align: justify; border: 0.7pt solid #444;
           padding: 4mm 5mm; }
.passage p { margin-bottom: 4pt; text-indent: 0; }
.material { font-size: 9.5pt; }
.material > p { text-align: justify; }
u.ref { text-underline-offset: 2pt; }
span.gap { border-bottom: 0.6pt solid #333; padding: 0 1mm; letter-spacing: 1pt; }

/* ── 그림(인라인 SVG) ──────────────────── */
/* 도형·그래프·다이어그램은 SVG로 직접 그린다. 외부 파일을 두지 않는다.
   SVG 에 width·height 를 픽셀로 명시해야 layout.py 의 높이 실측이 맞는다 (규칙 8-11).
   실측 시 본문 폭을 180mm(약 680px)로 강제하므로 width 는 640px 이하로 둔다 (8-11a). */
.figure { text-align: center; margin: 2.5mm 0 1.5mm; break-inside: avoid; }
.figure svg { display: block; margin: 0 auto; }
.figure .cap { font-size: 8.6pt; color: #333; margin-top: 1mm; }
svg text { font-family: 'Malgun Gothic', 'Noto Sans KR', sans-serif; }

.box { border: 0.7pt solid #333; padding: 3mm 4mm; margin: 2.2mm 0; break-inside: avoid; }
.box-title { text-align: center; font-weight: 700; margin-bottom: 1.8mm; }
/* 상자 안에서 구획을 나누는 제목. 조건과 <보기> 를 한 상자에 담을 때 쓴다 —
   상자를 둘로 나누면 테두리가 두 겹처럼 보인다. */
.box .box-title:not(:first-child) { margin-top: 3.4mm; padding-top: 2.8mm;
                                    border-top: 0.5pt solid #999; }
.box p { margin-bottom: 2.4pt; }

table.data { border-collapse: collapse; width: 100%; font-size: 8.9pt; margin: 1.5mm 0 1mm; }
table.data caption { font-weight: 700; text-align: left; margin-bottom: 1.2mm; font-size: 9.3pt; }
table.data th, table.data td { border: 0.5pt solid #333; padding: 1.1mm 1.4mm; text-align: center; }
table.data th { background: #efefef; font-weight: 700; }

table.excel { border-collapse: collapse; font-size: 8.6pt; margin: 2mm auto; }
table.excel th, table.excel td { border: 0.4pt solid #999; padding: 0.9mm 2.2mm; }
table.excel th { background: #e6e6e6; text-align: center; font-weight: 700; }

p.note { font-size: 8.5pt; margin: 0.6mm 0 0; line-height: 1.4; }
p.unit { text-align: right; font-size: 8.5pt; margin: 0 0 0.5mm; }
code { font-family: Consolas, 'Courier New', monospace; font-size: 9pt; }

/* ── OMR ───────────────────────────────── */
.omr { break-before: page; }
.omr h3 { text-align: center; font-size: 13pt; letter-spacing: 4pt; margin: 0 0 6mm; }
.omr-wrap { display: flex; gap: 6mm; justify-content: center; }
table.omr-t { border-collapse: collapse; font-size: 8.6pt; }
table.omr-t th, table.omr-t td { border: 0.5pt solid #333; padding: 1.1mm 1.6mm; text-align: center; }
table.omr-t th { background: #efefef; }
table.omr-t td.n { font-weight: 700; background: #f7f7f7; width: 9mm; }
</style>

{# ─────────────────────────── 표지 ─────────────────────────── #}
<div class="cover">
  <div class="brand">{{ brand }}</div>
  <div class="rule"></div>
  <h1>{{ exam_title }}</h1>
  <h2>{{ exam_round }}</h2>
  <div class="meta">
    국가직무능력표준 기반 직업기초능력평가<br>
    <strong>{{ total_q }}문항 / {{ total_min }}분</strong>
  </div>
  <div class="idbox">
    <table>
      <tr><td class="lab">수험번호</td><td class="blank"></td></tr>
      <tr><td class="lab">성&nbsp;&nbsp;&nbsp;&nbsp;명</td><td class="blank"></td></tr>
    </table>
  </div>
</div>

{# ─────────────────────────── 안내면 ────────────────────────── #}
<div class="info">
  <h3>시험 안내</h3>
  <div class="sub">문제 풀이 시작과 종료 시각을 정한 후 실전처럼 풀어 보십시오.</div>

  <table class="plan">
    <tr><th>구분</th><th>영역</th><th>문항 수</th><th>문항 번호</th></tr>
    {% set ns = namespace(start=1) %}
    {% for area, cnt in areas %}
    <tr>
      <td>{{ loop.index }}</td>
      <td>{{ area }}</td>
      <td>{{ cnt }}문항</td>
      <td>{{ '%02d'|format(ns.start) }} ~ {{ '%02d'|format(ns.start + cnt - 1) }}</td>
    </tr>
    {% set ns.start = ns.start + cnt %}
    {% endfor %}
    <tr><th colspan="2">합계</th><th>{{ total_q }}문항</th><th>{{ total_min }}분</th></tr>
  </table>

  <div class="notice">
    <div class="t">수험생 유의사항</div>
    <ol>
      <li>답안지의 해당란에 수험번호와 성명을 정확히 기재하십시오.</li>
      <li>모든 문항은 5지선다형이며, 각 문항당 하나의 답만 고르십시오.</li>
      <li>영역별 풀이 시간은 자율적으로 배분하되, 전체 {{ total_min }}분을 넘기지 마십시오.</li>
      <li>계산이 필요한 문항은 문두에 제시된 반올림·절사 조건을 반드시 확인하십시오.</li>
      <li>자료 아래의 각주(※)에 계산식·적용 범위·예외 규정이 제시되는 경우가 있습니다.</li>
      <li>시험이 시작되기 전까지 문제지를 넘기지 마십시오.</li>
    </ol>
  </div>
</div>

{# ─────────────────────────── 문항 ─────────────────────────── #}
{% for b in blocks %}
  <div class="qset" data-blk="{{ b.blk }}"{% if b.pagebreak %} style="break-before:page"{% endif %}>
    {% if b.lead or b.passage %}
    <div class="qhead" data-blk="{{ b.blk }}p">
      {% if b.lead %}<div class="lead">{{ b.lead }}</div>{% endif %}
      {% if b.passage %}<div class="passage">{{ b.passage }}</div>{% endif %}
    </div>
    {% endif %}
    <div class="qbody" data-blk="{{ b.blk }}q"{% if b.spread_break %} style="break-before:page"{% endif %}>
      {% for q in b.questions %}
      <div class="question">
        <div class="stem"><span class="qno">{{ '%02d'|format(q.no) }}</span>{{ q.stem }}</div>
        {% if q.material %}<div class="material">{{ q.material }}</div>{% endif %}
        <ul class="choices{% if q.cols == 2 %} c2{% endif %}">
          {% for c in q.choices %}
          <li><span class="m">{{ circled[loop.index0] }}</span> {{ c }}</li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>
  </div>
{% endfor %}

{# ─────────────────────────── OMR ──────────────────────────── #}
<div class="omr">
  <h3>답 안 지</h3>
  <div class="omr-wrap">
    {% set per = (questions|length / 3)|round(0, 'ceil')|int %}
    {% for chunk in range(3) %}
    <table class="omr-t">
      <tr><th>번호</th><th colspan="5">답 란</th></tr>
      {% for q in questions[chunk*per:(chunk+1)*per] %}
      <tr>
        <td class="n">{{ '%02d'|format(q.no) }}</td>
        {% for m in circled %}<td>{{ m }}</td>{% endfor %}
      </tr>
      {% endfor %}
    </table>
    {% endfor %}
  </div>
</div>
