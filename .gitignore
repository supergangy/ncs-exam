# Python
__pycache__/
*.py[cod]
venv/
.venv/

# 빌드 중간 산출물 (PDF는 커밋한다). 산출물은 out/<회차>/ 아래에 쌓인다.
out/**/*.html
# layout.py 의 블록 높이 측정용 임시 HTML
out/**/.layout/

# 참고 교재에서 추출한 원문 텍스트 — 상용 저작물이므로 절대 커밋 금지
scratchpad/
ref_dump.txt
*_dump.txt

# OS
Thumbs.db
desktop.ini
.DS_Store

# 시판 교재 원문 — 상용 저작물이므로 커밋 금지 (corpus/README.md 참고)
corpus/raw/
corpus/parsed/

# 필기후기 원문 — 작성자 저작물이므로 커밋 금지 (reviews/README.md 참고)
# db.json 의 분류 결과만 커밋한다.
reviews/raw/

# 웹 재제작 — 의존성은 담지 않는다
web/node_modules/
web/dist/
docs/*.render.html
web/public/data/

# 로고 중간 산출물 — 배포된 것은 app/ web/public/ mobile/ 에 있다
brand/out/

# 폰트 원본 — brand/fonts.py 가 다시 받는다 (13MB). 서브셋 결과는 web/public/fonts/ 에 있다
brand/fonts-src/*.woff2
brand/fonts-src/*.ttf
brand/fonts-src/OFL-*.txt
